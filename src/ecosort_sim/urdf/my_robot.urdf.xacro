<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur5e_con_gripper">

  <!-- 0. Crear el mundo para anclar el robot -->
  <link name="world" />

  <!-- 1. Traer el brazo UR5e -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro" />
  <xacro:ur_robot
    name="ur5e"
    tf_prefix=""
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/ur5e/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/ur5e/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur5e/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur5e/visual_parameters.yaml"
    sim_ignition="true">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:ur_robot>

  <!-- 2. Traer el Gripper y conectarlo a la punta del brazo -->
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro" />
  <xacro:robotiq_gripper name="robotiq_gripper" prefix="" parent="tool0" sim_gazebo="true">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:robotiq_gripper>

  <!-- 3. Configurar ros2_control para la simulacion en Jazzy -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find ecosort_sim)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
